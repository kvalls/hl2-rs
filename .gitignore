# Deny files by default; traverse directories to reach explicit source paths.
*
!*/
!/.gitignore
!/AGENTS.md
!/STATUS.md
!/MODLOG.md
!/README.md
!/CONTRIBUTING.md
!/LICENSE
!/Cargo.toml
!/Cargo.lock
!/.github/workflows/rust.yml
!/.vscode/launch.json
!/.vscode/tasks.json
!/launch*.cmd
!/launch*.sh
!/scripts/build-bevy.ps1
!/scripts/build-bevy.sh
!/scripts/clean-target.sh
!/scripts/checks/*.sh
!/scripts/checks/*.py
!/scripts/checks/architecture-baseline.json
!/test-inputs/*.json
!/test-inputs/expected/*.json
!/docs/*.md
!/docs/images/hl2-rs-trainstation.png
!/crates/**/Cargo.toml
!/crates/**/src/**/*.rs
!/crates/hl2-bevy/assets/shaders/*.wgsl
!/crates/source-ui/assets/fonts/ProggyClean.ttf
!/crates/source-ui/assets/fonts/LICENSE.txt
!/crates/source-ui/assets/fonts/README.md
!/crates/hl2-ui/assets/display/modes.json
!/crates/hl2-ui/assets/ui/tuning.json
!/crates/hl2-ui/assets/ui/*.res
!/crates/hl2-ui/src/console/commands/cvars.golden
# Generated/private directories remain closed to all extensions.
**/target/
/bin/
/artifacts/
/local.json
/docs/local-recon.json
